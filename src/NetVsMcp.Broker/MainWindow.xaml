<Window x:Class="NetVsMcp.Broker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetVsMcp Broker"
        Height="640"
        MinHeight="520"
        Width="960"
        MinWidth="760">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="NetVsMcp Broker" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Copy MCP Config" Click="CopyConfig_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Refresh" Click="Refresh_Click" Padding="12,6" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Header="Local MCP Registration" Grid.Row="0" Margin="0,0,0,12">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Endpoint" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding McpEndpoint}" />

                    <TextBlock Grid.Row="1" Text="VSIX pipe" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PipeName}" Margin="0,6,0,0" />

                    <TextBox Grid.Row="2"
                             Grid.ColumnSpan="2"
                             Text="{Binding McpRegistrationJson}"
                             Margin="0,12,0,0"
                             FontFamily="Consolas"
                             MinHeight="96"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Registered Visual Studio Instances" Grid.Row="1" Margin="0,0,0,12">
                <DataGrid ItemsSource="{Binding Sessions}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Margin="12">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActiveWindow}" Width="64" />
                        <DataGridTextColumn Header="Solution" Binding="{Binding SolutionName}" Width="*" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                        <DataGridTextColumn Header="Debugger" Binding="{Binding DebuggerMode}" Width="100" />
                        <DataGridTextColumn Header="Active Document" Binding="{Binding ActiveDocument}" Width="2*" />
                        <DataGridTextColumn Header="Last Seen UTC" Binding="{Binding LastSeenUtc}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Recent Activity" Grid.Row="2">
                <TextBox Margin="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Text="Broker skeleton is running. VSIX registration and HTTP MCP handlers will fill this log in later slices." />
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
