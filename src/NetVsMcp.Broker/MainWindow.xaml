<Window x:Class="NetVsMcp.Broker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetVsMcp Broker"
        Icon="Assets/broker.ico"
        Height="720"
        MinHeight="640"
        Width="1120"
        MinWidth="860">
    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NetVsMcp Broker" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding Version}" Margin="8,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border BorderThickness="1" Padding="9,3" CornerRadius="12" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource DangerBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RunningState}" FontWeight="SemiBold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="  •  " VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding LastRefreshedText}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Check for Updates" Click="CheckForUpdates_Click" />
                <Button Content="Refresh" Click="Refresh_Click" />
                <Button Content="Exit" Click="Exit_Click" Margin="0" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top"
                Background="#FFF8E6"
                BorderBrush="#E8A000"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,12"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding UpdateBannerText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#7A4800" />
                <Button Grid.Column="1"
                        Content="{Binding InstallButtonContent}"
                        IsEnabled="{Binding IsNotInstallingUpdate}"
                        Click="InstallUpdate_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0" />
            </Grid>
        </Border>

        <TabControl>
            <TabItem Header="STATUS">
                <GroupBox Header="Connection" Margin="0,4,0,0">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="MCP endpoint" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding McpEndpoint}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Copy" Click="CopyEndpoint_Click" Margin="0" />

                        <TextBlock Grid.Row="1" Text="Web automation" FontWeight="SemiBold" Margin="0,10,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding McpWebAutomationEndpoint}" Margin="0,10,0,0" VerticalAlignment="Center" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Copy" Click="CopyWebAutomationEndpoint_Click" Margin="0,10,0,0" />

                        <TextBlock Grid.Row="2" Text="Named pipe" FontWeight="SemiBold" Margin="0,10,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PipeName}" Margin="0,10,0,0" VerticalAlignment="Center" />
                        <Button Grid.Row="2" Grid.Column="2" Content="Copy" Click="CopyPipe_Click" Margin="0,10,0,0" />

                        <TextBlock Grid.Row="3" Text="Start at login" FontWeight="SemiBold" Margin="0,10,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AutostartStatus}" Margin="0,10,0,0" VerticalAlignment="Center" />
                        <Button Grid.Row="3" Grid.Column="2" Content="Toggle" Click="ToggleAutostart_Click" Margin="0,10,0,0" />

                        <TextBlock Grid.Row="4" Text="Logs folder" FontWeight="SemiBold" Margin="0,10,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LogsFolder}" Margin="0,10,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="4" Grid.Column="2" Content="Open" Click="OpenLogs_Click" Margin="0,10,0,0" />

                        <TextBlock Grid.Row="5" Text="Client config" FontWeight="SemiBold" Margin="0,10,0,0" VerticalAlignment="Top" />
                        <TextBox Grid.Row="5" Grid.Column="1"
                                 Text="{Binding McpRegistrationJson, Mode=OneWay}"
                                 Margin="0,10,0,0"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 MinHeight="80"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                        <Button Grid.Row="5" Grid.Column="2" Content="Copy" Click="CopyConfig_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0" VerticalAlignment="Top" />
                    </Grid>
                </GroupBox>
            </TabItem>

            <TabItem Header="SESSIONS">
                <Grid Margin="0,4,0,0">
                    <DataGrid ItemsSource="{Binding Sessions}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Session ID" Binding="{Binding SessionId}" Width="Auto" />
                            <DataGridTextColumn Header="Debugger" Binding="{Binding DebuggerMode}" Width="Auto" />
                            <DataGridTextColumn Header="Solution" Binding="{Binding SolutionPath}" Width="*"/>
                            <DataGridTextColumn Header="Capabilities" Binding="{Binding Capabilities}" Width="*" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Visibility="{Binding NoSessions, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="No Visual Studio sessions yet"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Open Visual Studio with the NetVsMcp VSIX installed and it will register here automatically."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="SETTINGS">
                <StackPanel Margin="0,4,0,0">
                    <GroupBox Header="Capability profile">
                        <StackPanel Orientation="Horizontal" Margin="14">
                            <ComboBox ItemsSource="{Binding AvailableCapabilityProfiles}"
                                      SelectedItem="{Binding CapabilityProfile}"
                                      Width="160"
                                      HorizontalAlignment="Left" />
                            <TextBlock Text="Controls which broker tools MCP clients may call. Changes are saved and take effect immediately."
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="14,0,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Startup settings (restart required to apply)">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Port" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="1" Text="Logs folder" FontWeight="SemiBold" Margin="0,8,0,0" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LogsDirectoryText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />

                            <TextBlock Grid.Row="2" Text="Sessions folder" FontWeight="SemiBold" Margin="0,8,0,0" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SessionsDirectoryText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />

                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Save Settings" Click="ApplySettings_Click" Style="{StaticResource AccentButtonStyle}" />
                                <TextBlock Text="Changes are saved but only take effect after restarting NetVsMcp Broker."
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
