<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\broker.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetVsMcp.Contracts\NetVsMcp.Contracts.csproj" />
    <ProjectReference Include="..\NetVsMcp.Broker.Core\NetVsMcp.Broker.Core.csproj" />
    <ProjectReference Include="..\NetVsMcp.Broker.Services\NetVsMcp.Broker.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\broker.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\.agents\skills\**\*" Link="BundledGuides\skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

</Project>
