<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <VsixDeployOnDebug>true</VsixDeployOnDebug>
    <RootNamespace>NetVsMcp.Vsix</RootNamespace>
    <AssemblyName>NetVsMcp.Vsix</AssemblyName>
    <BrokerVsixPublishDir Condition="'$(BrokerVsixPublishDir)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\vsix-broker\$(Configuration)\</BrokerVsixPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetVsMcp.Vsix.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared wire DTOs/enums with the broker. NetVsMcp.Contracts multi-targets
         netstandard2.0 specifically so this net472 project can consume it directly. -->
    <ProjectReference Include="..\NetVsMcp.Contracts\NetVsMcp.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Overview.md">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Assets\broker.ico">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.14.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
  </ItemGroup>

  <Target Name="PublishBrokerForVsix" BeforeTargets="GetVsixSourceItems" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild
      Projects="..\NetVsMcp.Broker\NetVsMcp.Broker.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);PublishDir=$(BrokerVsixPublishDir);SelfContained=false" />
    <WriteLinesToFile
      File="$(BrokerVsixPublishDir).netvsmcp-vsix-bundled-broker"
      Lines="This file marks this NetVsMcp Broker as bundled with the NetVsMcp Visual Studio extension. Do not delete it from the VSIX broker payload: the broker uses it to disable standalone broker self-updates because this copy is updated together with the Visual Studio extension."
      Overwrite="true" />
  </Target>

  <Target Name="AddBrokerPayloadToVsix" BeforeTargets="GenerateFileManifest" DependsOnTargets="PublishBrokerForVsix" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <BrokerVsixPayload Include="$(BrokerVsixPublishDir)**\*" />
      <VSIXSourceItem Include="@(BrokerVsixPayload)">
        <TargetPath>Broker\%(BrokerVsixPayload.RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>
</Project>
