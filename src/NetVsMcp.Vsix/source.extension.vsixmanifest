<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="NetVsMcp.Vsix" Version="2.2.5" Language="en-US" Publisher="Alex Swan" />
    <DisplayName>NetVsMcp - MCP Tools for Visual Studio</DisplayName>
    <Description xml:space="preserve">Connect MCP clients to local Visual Studio sessions for live editing, code navigation, builds, tests, and debugging through a loopback broker.</Description>
    <Icon>Assets\broker.ico</Icon>
    <Tags>mcp;ai agent;visual studio;vsix;debugger;build;tests;automation;roslyn;copilot;claude;local broker</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Overview" Path="Overview.md" />
  </Assets>
</PackageManifest>
