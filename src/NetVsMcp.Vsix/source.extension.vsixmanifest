<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="NetVsMcp.Vsix" Version="1.0.2" Language="en-US" Publisher="Alex Swan" />
    <DisplayName>NetVsMcp Visual Studio Bridge</DisplayName>
    <Description xml:space="preserve">Connects Visual Studio to NetVsMcp Broker so MCP clients can use live editor, navigation, build, debugger, and test tools. Requires the separate Broker app. Downloads and source: https://github.com/Alexander-Swan/netvs-mcp</Description>
    <Icon>Assets\broker.ico</Icon>
    <Tags>mcp;visual studio;debugger;agent</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Overview" Path="Overview.md" />
  </Assets>
</PackageManifest>
